<Project Sdk="Microsoft.NET.Sdk">
  <!-- The official rep4rep add-on: one DLL, nocatfarm.rep4rep.dll, dropped in nocat.farm's plugins folder (or installed from
       the dashboard's Plugins page). Built against the plugin API (src/NocatFarm/Plugins/IPlugin.cs) and nothing else. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>nocatfarm.rep4rep</AssemblyName>
    <RootNamespace>NocatFarm.Addons.Rep4Rep</RootNamespace>
    <!-- The add-on's own version: addons/addons.json lists it, and the dashboard says when a newer one is out. -->
    <Version>1.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: nocatFarm.dll is never copied beside the add-on - the one the app has loaded is the one it uses. -->
    <ProjectReference Include="..\..\src\NocatFarm\NocatFarm.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Its own translations, carried inside the DLL: lang/<code>.json, English text -> translated. -->
    <EmbeddedResource Include="lang\*.json" LogicalName="lang.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NocatFarm.Tests" />
  </ItemGroup>
</Project>
