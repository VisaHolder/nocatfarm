<Project Sdk="Microsoft.NET.Sdk">
  <!-- Signs addons/addons.json for the release (tools/package-release.ps1). Not part of the app: the private key never
       goes near it, and this has no dependencies. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
