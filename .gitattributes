# The Docker files are read on Linux: keep them LF even in a Windows checkout, where core.autocrlf would
# otherwise hand them CRLF.
Dockerfile text eol=lf
.dockerignore text eol=lf
docker-compose*.yml text eol=lf
# Run on a Mac: must stay LF, or bash reads "
" into every line.
*.command text eol=lf
*.sh text eol=lf
