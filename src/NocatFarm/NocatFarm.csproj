<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- WinExe, not Exe: a console app is handed a console window by Windows BEFORE any of our code runs,
         so it cannot be suppressed from inside. This starts with no console and allocates one only when
         something asks for it. -->
    <OutputType>WinExe</OutputType>
    <!-- Everywhere else there is no "console window handed out before our code runs" problem, and a headless Linux
         or Docker run IS a console app. So a normal Exe for any non-Windows target: `dotnet publish -r linux-x64`
         (or linux-arm64, or a plain build on Linux) gives an ordinary console program, while win-x64 and a plain
         build on Windows stay exactly as above. -->
    <OutputType Condition="'$(RuntimeIdentifier)' != '' And !$(RuntimeIdentifier.StartsWith('win'))">Exe</OutputType>
    <OutputType Condition="'$(RuntimeIdentifier)' == '' And !$([MSBuild]::IsOSPlatform('Windows'))">Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>nocatFarm</AssemblyName>
    <RootNamespace>NocatFarm</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.5.6</Version>
    <!-- A background app, not a server: the web SDK turns on the server collector, which keeps a heap per CPU core.
         The workstation collector is the right fit and holds far less memory for the same work. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <Product>nocatFarm</Product>
    <Company>nocat.lol</Company>
    <ApplicationIcon>nocatFarm.ico</ApplicationIcon>
    <!-- The dashboard is served from wwwroot; a launch profile would only get in the way of a console app. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Three packages and no more: Steam's HTML is hand-parsed (see CardFarmer) rather than pulling in a full parser. -->
    <!-- The QR codes for signing in with the Steam app and for opening the dashboard on a phone. -->
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
    <PackageReference Include="SteamKit2" Version="3.3.0" />
    <!-- DPAPI. Windows-only by nature; elsewhere Secrets uses AES-GCM with a key file in config/state instead. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped alongside the exe as well as embedded, so the console window can load it at runtime. -->
    <None Include="nocatFarm.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
